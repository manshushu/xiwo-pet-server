{
  "name": "xiwo-pet-server",
  "version": "2.1.0",
  "description": "西沃智慧宠物局域网双端交互系统（教师机管控台与学生端）",
  "main": "src/server.js",
  "bin": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "build:exe": "npx @yao-pkg/pkg . --targets node20-win-x64 --output bin/xiwo-pet-server.exe"
  },
  "pkg": {
    "scripts": "src/**/*.js",
    "assets": [
      "src/public/**/*",
      "data/**/*"
    ]
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "uuid": "^9.0.1",
    "ws": "^8.16.0"
  },
  "keywords": [
    "xiwo",
    "pet",
    "classroom",
    "lan"
  ],
  "author": "Antigravity",
  "license": "ISC"
}
